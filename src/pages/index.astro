---
import Layout from "../layouts/Layout.astro";
import Ankuendigungen from "../components/Ankuendigungen.astro";
import { Image } from 'astro:assets';
import ogvLogo from '@/images/ogv_logo.gif';
---

<Layout
  title="Herzlich Willkommen"
  teaserImage="/images/willkommen.jpg"
  teaserPosition="50% 27%"
  teaserAltText="Willkommen beim Obst- und Gartenbauverein Pattenhofen Altenthann e.V."
>
  <h1>Herzlich Willkommen</h1>
  <p>
    auf der Homepage des Vereins für Gartenbau und Landespflege
    Pattenhofen-Altenthann e.V.
  </p>

  <p>
    Wir freuen uns, dass Sie unsere Seite angeklickt haben. Hier finden Sie
    Infos über Verein, Arbeit, Veranstaltungen und Geräte.
  </p>
  <p>
    Viel Spaß beim Durchschauen. Vielleicht haben wir Ihr Interesse geweckt und
    sehen Sie bald bei einer unserer Veranstaltungen.
  </p>
  <p>
    Ihr
    <br /> Gartenbauverein
  </p>

  <aside
    style="margin-top: 50px; background-color: #DFFCD6; border-radius: 5px; padding: 10px;"
  >
    <h2>Mostsaison 2026</h2>
    <p>
      Die neuen Mosttermine sind online. Mosttermine können ab sofort über unser{" "}
      <a href="/mosterei">Formular</a> angefragt werden.
    </p>
  </aside>

  <Image src={ogvLogo} alt="Logo OGV" loading="eager" />

  <br />

  <Ankuendigungen />

  
</Layout>
